{
  "name": "maxi-review",
  "version": "0.1.0",
  "private": true,
  "description": "Maxi PR review action with analyzer context and Jules review feedback.",
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "commit": "git add . && cz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxi-tools/maxi-reviewer.git"
  },
  "author": "maxi-tools",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/maxi-tools/maxi-reviewer/issues"
  },
  "homepage": "https://github.com/maxi-tools/maxi-reviewer#readme",
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@google/jules-sdk": "^0.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vercel/ncc": "^0.44.1",
    "@vitest/coverage-v8": "^4.1.8",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.8"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
